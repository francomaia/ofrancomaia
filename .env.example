# Copie para .env.local (ignorado pelo git) e preencha.
# Na Hostinger, cadastre estas mesmas chaves no painel do app Node.

# --- Entrega do formulário por e-mail (caminho principal) ---
# Chave da API do Resend: https://resend.com/api-keys
RESEND_API_KEY=""
# Para onde os leads vão. Sem isso, cai no e-mail definido em lib/site.ts.
CONTACT_TO_EMAIL="francomaiadeoliveira@gmail.com"
# Remetente. Use onboarding@resend.dev para testar; em produção, um endereço
# de um domínio verificado no Resend (ex.: "Site <contato@ofrancomaia.com>").
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# --- Alternativa: encaminhar o lead como JSON (Zapier, Make, n8n, Slack) ---
CONTACT_WEBHOOK_URL=""

# --- URL pública do site (canonical, OG, sitemap, robots) ---
NEXT_PUBLIC_SITE_URL="https://ofrancomaia.com"

# --- Posts recentes de @ofrancomaia pela API oficial da Meta ---
# Token do Instagram API with Instagram Login com instagram_business_basic.
# Sem ele, a seção mostra seis capas reais salvas no projeto.
INSTAGRAM_ACCESS_TOKEN=""
